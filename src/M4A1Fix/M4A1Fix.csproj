<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>M4A1Fix</AssemblyName>
    <RootNamespace>M4A1Fix</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <GamePath Condition="'$(GamePath)' == '' and '$(M4A1FIX_GAME_PATH)' != ''">$(M4A1FIX_GAME_PATH)</GamePath>
    <ManagedPath>$(GamePath)\Risk of Rain 2_Data\Managed</ManagedPath>

    <M4A1ModPath Condition="'$(M4A1ModPath)' == '' and '$(M4A1FIX_M4A1_PATH)' != ''">$(M4A1FIX_M4A1_PATH)</M4A1ModPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == '' and '$(M4A1FIX_BEPINEX_CORE)' != '' and Exists('$(M4A1FIX_BEPINEX_CORE)\BepInEx.dll')">$(M4A1FIX_BEPINEX_CORE)</BepInExCorePath>
    <_M4A1FixBepInputName Condition="'$(M4A1FIX_BEPINEX_CORE)' != ''">$([System.IO.Path]::GetFileName('$(M4A1FIX_BEPINEX_CORE)'))</_M4A1FixBepInputName>
    <BepInExDllPath Condition="'$(BepInExDllPath)' == '' and '$(BepInExCorePath)' == '' and '$(_M4A1FixBepInputName)' == 'BepInEx.dll'">$(M4A1FIX_BEPINEX_CORE)</BepInExDllPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == '' and Exists('$(GamePath)\BepInEx\core\BepInEx.dll')">$(GamePath)\BepInEx\core</BepInExCorePath>
    <BepInExDllPath Condition="'$(BepInExDllPath)' == '' and '$(BepInExCorePath)' != ''">$(BepInExCorePath)\BepInEx.dll</BepInExDllPath>
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == '' and '$(BepInExDllPath)' != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(BepInExDllPath)')), '0Harmony.dll'))</HarmonyDllPath>
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == '' and '$(BepInExCorePath)' != ''">$(BepInExCorePath)\0Harmony.dll</HarmonyDllPath>
    <HlapiRuntimePath Condition="'$(HlapiRuntimePath)' == ''">$(ManagedPath)\com.unity.multiplayer-hlapi.Runtime.dll</HlapiRuntimePath>
    <NetworkingAssemblyPath Condition="'$(NetworkingAssemblyPath)' == '' and Exists('$(ManagedPath)\UnityEngine.Networking.dll')">$(ManagedPath)\UnityEngine.Networking.dll</NetworkingAssemblyPath>
    <NetworkingReferenceName Condition="'$(NetworkingReferenceName)' == '' and Exists('$(ManagedPath)\UnityEngine.Networking.dll')">UnityEngine.Networking</NetworkingReferenceName>
    <NetworkingAssemblyPath Condition="'$(NetworkingAssemblyPath)' == '' and Exists('$(ManagedPath)\UnityEngine.UNETModule.dll')">$(ManagedPath)\UnityEngine.UNETModule.dll</NetworkingAssemblyPath>
    <NetworkingReferenceName Condition="'$(NetworkingReferenceName)' == '' and Exists('$(ManagedPath)\UnityEngine.UNETModule.dll')">UnityEngine.UNETModule</NetworkingReferenceName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDllPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDllPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RoR2"><HintPath>$(ManagedPath)\RoR2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(ManagedPath)\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(ManagedPath)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(NetworkingReferenceName)"><HintPath>$(NetworkingAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime"><HintPath>$(HlapiRuntimePath)</HintPath><Private>false</Private></Reference>
    <Reference Include="M4A1Mod"><HintPath>$(M4A1ModPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Import Project="..\..\build\M4A1Fix.Build.targets" />
</Project>
